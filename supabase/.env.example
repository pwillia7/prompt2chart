# LLM Provider Configuration
# Set to "openai" or "anthropic"
LLM_PROVIDER=openai

# OpenAI API Key (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here
# Optional: override default models (defaults: gpt-4o for chart gen, gpt-4o-mini for chat)
# OPENAI_MODEL=gpt-4o
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Anthropic API Key (required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# Optional: override default models (defaults: claude-sonnet-4-5 for chart gen, claude-haiku-4-5 for chat)
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001

# CORS: Restrict to your frontend domain in production
# Leave unset or '*' for local development
# ALLOWED_ORIGIN=https://your-app-domain.com
