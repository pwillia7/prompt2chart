# Supabase Configuration (Local Development)
# Run `supabase start` to get these values
VITE_SUPABASE_URL=http://localhost:54321

# Use the "Publishable" key from `supabase start` output (sb_publishable_...)
# Or if your CLI outputs legacy keys, use the "anon key" (eyJ...)
VITE_SUPABASE_ANON_KEY=<your-publishable-or-anon-key-from-supabase-start>
